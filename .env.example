# ============================================================
# LocalDeploy — Environment Configuration
# Copy to `.env` and adjust. All variables use the LOCALDEPLOY_ prefix.
# ============================================================

# --- Core ---
# Secret key used for signing/encryption (sessions, encrypted secrets).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left empty in development, a key is generated and persisted in ./data/.secret_key
LOCALDEPLOY_SECRET_KEY=
LOCALDEPLOY_ENVIRONMENT=development

# --- HTTP server ---
LOCALDEPLOY_HOST=0.0.0.0
LOCALDEPLOY_PORT=8000

# --- Database (platform's own database) ---
# Development default (SQLite). For production use the docker-compose Postgres:
# postgresql+psycopg://localdeploy:CHANGE_ME_STRONG_PASSWORD@postgres:5432/localdeploy
LOCALDEPLOY_DATABASE_URL=sqlite+aiosqlite:///./data/localdeploy.db

# --- CORS (dashboard origin(s)) ---
LOCALDEPLOY_CORS_ORIGINS=["http://localhost:3000"]

# --- Docker Engine ---
# Leave empty to use the local Docker socket / default environment.
# Examples:
#   unix://var/run/docker.sock                (Linux)
#   npipe:////./pipe/docker_engine            (Windows / Docker Desktop)
#   tcp://host:2375                           (remote engine — never expose publicly)
LOCALDEPLOY_DOCKER_HOST=

# --- Paths ---
LOCALDEPLOY_WORKSPACE_DIR=./data/workspace
LOCALDEPLOY_BACKUPS_DIR=./data/backups
# Path to the Traefik acme.json mounted into this container (enables SSL expiration
# monitoring). Leave empty when Traefik is not running on the same host.
LOCALDEPLOY_ACME_JSON_PATH=

# --- Deployment engine ---
LOCALDEPLOY_DEPLOY_NETWORK=localdeploy-network
LOCALDEPLOY_IMAGE_PREFIX=localdeploy
LOCALDEPLOY_DEPLOY_TIMEOUT_SECONDS=1800
LOCALDEPLOY_HEALTHCHECK_TIMEOUT_SECONDS=120

# --- First-run bootstrap admin ---
# Created on first start when no users exist. CHANGE THE PASSWORD AFTER LOGIN.
LOCALDEPLOY_FIRST_ADMIN_USERNAME=admin
LOCALDEPLOY_FIRST_ADMIN_EMAIL=admin@localdeploy.local
LOCALDEPLOY_FIRST_ADMIN_PASSWORD=localdeploy123

# --- Sessions & metrics ---
LOCALDEPLOY_SESSION_TTL_MINUTES=10080
LOCALDEPLOY_METRICS_SAMPLE_SECONDS=15
LOCALDEPLOY_METRICS_RETENTION_HOURS=48

# --- Public URL used for DNS/webhook instructions ---
LOCALDEPLOY_PUBLIC_BASE_URL=http://localhost:8000
